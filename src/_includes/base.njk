<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or "Tech Off My Plate" }}</title>
<meta name="description" content="{{ description or "Practical tech support for independent professionals and small business owners: new business tech setup, dedicated working hours and business systems consultancy." }}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://www.techoffmyplate.com{{ page.url }}">

<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="Tech Off My Plate">
<meta property="og:title" content="{{ title or "Tech Off My Plate" }}">
<meta property="og:description" content="{{ description or "Making technology work better for your business." }}">
<meta property="og:image" content="https://www.techoffmyplate.com{{ ogImage or '/images/marie-hero.jpg' }}">
<meta property="og:url" content="https://www.techoffmyplate.com{{ page.url }}">
<meta property="og:locale" content="en_GB">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title or "Tech Off My Plate" }}">
<meta name="twitter:description" content="{{ description or "Making technology work better for your business." }}">
<meta name="twitter:image" content="https://www.techoffmyplate.com{{ ogImage or '/images/marie-hero.jpg' }}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Karla:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">

{% if eleventyNavigation.key == "Home" or page.url == "/" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Tech Off My Plate",
  "image": "https://www.techoffmyplate.com/images/marie-hero.jpg",
  "url": "https://www.techoffmyplate.com/",
  "email": "marie@techoffmyplate.com",
  "description": "Practical tech support for independent professionals and small business owners: new business tech setup, dedicated working hours and business systems consultancy.",
  "areaServed": "GB",
  "address": { "@type": "PostalAddress", "addressRegion": "Essex", "addressCountry": "GB" },
  "founder": { "@type": "Person", "name": "Marie", "jobTitle": "Founder, Tech Off My Plate" },
  "sameAs": ["https://www.instagram.com/techoffmyplate"],
  "priceRange": "££",
  "makesOffer": [
    { "@type": "Offer", "name": "New Business Tech Setup", "description": "Essential business tech set up, connected and tested for people starting a business. Done for you, done with you, or a mix of both. Quoted before work begins.", "priceSpecification": { "@type": "PriceSpecification", "minPrice": "300", "priceCurrency": "GBP" } },
    { "@type": "Offer", "name": "Tech Working Hours (60 minutes)", "description": "Dedicated, hands-on time to get tech jobs done, together or independently. Remote or in person by arrangement.", "price": "125", "priceCurrency": "GBP" },
    { "@type": "Offer", "name": "Tech Working Hours (120 minutes)", "description": "Dedicated, hands-on time to get tech jobs done, together or independently. Remote or in person by arrangement.", "price": "225", "priceCurrency": "GBP" },
    { "@type": "Offer", "name": "Business Systems & Technology Consultancy", "description": "Systems reviews, workflow improvements, automation, implementation and bespoke systems or app development, scoped according to the work involved.", "priceSpecification": { "@type": "PriceSpecification", "minPrice": "495", "priceCurrency": "GBP" } }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Who do you work with?", "acceptedAnswer": { "@type": "Answer", "text": "I work with business owners who want to improve how their systems and technology support the way they work. You don't need a technical background or a particular type of business to get started." } },
    { "@type": "Question", "name": "Is this only for new businesses?", "acceptedAnswer": { "@type": "Answer", "text": "No. New Business Tech Setup is for people getting started, Tech Working Hours is for getting jobs done in an existing business, and consultancy is for improving more complex systems." } },
    { "@type": "Question", "name": "Do I need to know which service I want?", "acceptedAnswer": { "@type": "Answer", "text": "No. Book an introductory call and we'll work out which option makes sense for what you're trying to achieve." } },
    { "@type": "Question", "name": "What's the difference between Tech Working Hours and consultancy?", "acceptedAnswer": { "@type": "Answer", "text": "Tech Working Hours is dedicated time to get defined jobs done, either together or with me working on them independently. Consultancy starts with understanding how part of your business works, then covers recommendations and, where appropriate, implementation, automation or bespoke development." } },
    { "@type": "Question", "name": "Can you build things as well as advise?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Consultancy can include implementation, automation and, where it makes sense, bespoke systems or apps. Larger work is scoped and quoted before anything starts, so you can decide whether you'd like help putting it into practice." } },
    { "@type": "Question", "name": "Do I need to buy new software?", "acceptedAnswer": { "@type": "Answer", "text": "Not necessarily. Often the best starting point is making better use of what you already have." } },
    { "@type": "Question", "name": "Can you help if I'm considering an app or new platform?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We can assess your requirements, compare options and look at feasibility and ongoing costs before you commit to development." } },
    { "@type": "Question", "name": "Do you work remotely or in person?", "acceptedAnswer": { "@type": "Answer", "text": "Both, depending on the service and location. We'll agree on the most suitable format before booking." } },
    { "@type": "Question", "name": "Is the introductory call free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. It's a free 20-minute conversation to understand what you need and establish whether I can help. Detailed consultancy, research and technical work take place through paid services." } }
  ]
}
</script>
{% endif %}
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>

<nav class="topnav">
  <div class="wrap">
    <a href="/"><img class="nav-logo" src="/images/wordmark.png" width="700" height="93" alt="Tech Off My Plate"></a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle">
    <div class="nav-links">
      <div class="nav-dropdown">
        <a href="/#services">Services</a>
        <div class="nav-submenu">
          <a href="/new-business-tech-setup/">New Business Tech Setup</a>
          <a href="/#working-hours">Tech Working Hours</a>
          <a href="/#consultancy">Business Systems &amp; Technology Consultancy</a>
        </div>
      </div>
      <a href="/#how">How We Work</a>
      <a href="/#about">About</a>
      <a href="/#faq">FAQ</a>
      <a href="/blog/">Blog</a>
      <a class="btn btn-primary" href="https://calendar.app.google/5X8u7FaaufFGnoS19" target="_blank" rel="noopener">Book a Chat</a>
    </div>
    <label for="nav-toggle" class="nav-toggle-btn"><span></span><span></span><span></span></label>
  </div>
</nav>

{{ content | safe }}

<p>&copy; 2026 Tech Off My Plate &middot; techoffmyplate.com &middot; <a href="/privacy/">Privacy Notice</a></p>
</div>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", user => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
</body>
</html>
