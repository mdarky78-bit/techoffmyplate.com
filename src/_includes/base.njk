<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or "Tech Off My Plate" }}</title>
<meta name="description" content="{{ description or "Tech Off My Plate is a business systems and technology consultancy. I help business owners find what's slowing them down, make better use of their tools and, where it makes sense, put improvements in place." }}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://www.techoffmyplate.com{{ page.url }}">

<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="Tech Off My Plate">
<meta property="og:title" content="{{ title or "Tech Off My Plate" }}">
<meta property="og:description" content="{{ description or "Making technology work better for your business." }}">
<meta property="og:image" content="https://www.techoffmyplate.com{{ ogImage or '/images/marie-hero.jpg' }}">
<meta property="og:url" content="https://www.techoffmyplate.com{{ page.url }}">
<meta property="og:locale" content="en_GB">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title or "Tech Off My Plate" }}">
<meta name="twitter:description" content="{{ description or "Making technology work better for your business." }}">
<meta name="twitter:image" content="https://www.techoffmyplate.com{{ ogImage or '/images/marie-hero.jpg' }}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Karla:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">

{% if eleventyNavigation.key == "Home" or page.url == "/" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Tech Off My Plate",
  "image": "https://www.techoffmyplate.com/images/marie-hero.jpg",
  "url": "https://www.techoffmyplate.com/",
  "email": "marie@techoffmyplate.com",
  "description": "Business systems and technology consultancy. Helping business owners find what's slowing them down, make better use of their tools and, where it makes sense, put improvements in place.",
  "areaServed": "GB",
  "address": { "@type": "PostalAddress", "addressRegion": "Essex", "addressCountry": "GB" },
  "founder": { "@type": "Person", "name": "Marie", "jobTitle": "Founder, Tech Off My Plate" },
  "sameAs": ["https://www.instagram.com/techoffmyplate"],
  "priceRange": "££",
  "makesOffer": [
    { "@type": "Offer", "name": "Tech Working Session (60 minutes)", "description": "Collaborative help with one defined issue or task, with a brief intake and short follow-up summary. Remote or in person by arrangement.", "price": "125", "priceCurrency": "GBP" },
    { "@type": "Offer", "name": "Tech Working Session (120 minutes)", "description": "Collaborative help with one defined issue or task, with a brief intake and short follow-up summary. Remote or in person by arrangement.", "price": "225", "priceCurrency": "GBP" },
    { "@type": "Offer", "name": "Focused Systems Review", "description": "Assessment of one defined workflow, with discovery, written recommendations, a practical action plan and a 30-minute follow-up.", "priceSpecification": { "@type": "PriceSpecification", "minPrice": "495", "priceCurrency": "GBP" } },
    { "@type": "Offer", "name": "Business Systems Review", "description": "Review of up to three connected workflows, with discovery, research where appropriate, prioritised recommendations and a 60-minute review call.", "priceSpecification": { "@type": "PriceSpecification", "minPrice": "995", "priceCurrency": "GBP" } },
    { "@type": "Offer", "name": "Systems Implementation & Automation", "description": "Improvements to existing systems, connecting tools, automations and business dashboards. Separately scoped and quoted." },
    { "@type": "Offer", "name": "Bespoke Systems & App Feasibility", "description": "Assessment of requirements, alternatives, feasibility, costs and ongoing maintenance before deciding whether to build. Separately quoted." }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Who do you work with?", "acceptedAnswer": { "@type": "Answer", "text": "I work with business owners who want to improve how their systems and technology support the way they work. You don't need a technical background or a particular type of business to get started." } },
    { "@type": "Question", "name": "Do I need to know which service I want?", "acceptedAnswer": { "@type": "Answer", "text": "No. Book an introductory call and we'll work out which option makes sense for what you're trying to achieve." } },
    { "@type": "Question", "name": "What's the difference between a Working Session and a Systems Review?", "acceptedAnswer": { "@type": "Answer", "text": "A Working Session is for tackling a specific, defined issue together. A Systems Review is a more detailed assessment of how part of your business operates, followed by written recommendations and an action plan." } },
    { "@type": "Question", "name": "Can you implement the recommendations?", "acceptedAnswer": { "@type": "Answer", "text": "Where the work is within my scope, yes. Implementation is quoted separately so you can decide whether you'd like help putting the recommendations into practice." } },
    { "@type": "Question", "name": "Do I need to buy new software?", "acceptedAnswer": { "@type": "Answer", "text": "Not necessarily. Often the best starting point is making better use of what you already have." } },
    { "@type": "Question", "name": "Can you help if I'm considering an app or new platform?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We can assess your requirements, compare options and look at feasibility and ongoing costs before you commit to development." } },
    { "@type": "Question", "name": "Do you work remotely or in person?", "acceptedAnswer": { "@type": "Answer", "text": "Both, depending on the service and location. We'll agree on the most suitable format before booking." } },
    { "@type": "Question", "name": "Is the introductory call free?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. It's a free 20-minute conversation to understand what you need and establish whether I can help. Detailed consultancy, research and technical work take place through paid services." } }
  ]
}
</script>
{% endif %}
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>

<nav class="topnav">
  <div class="wrap">
    <a href="/"><img class="nav-logo" src="/images/wordmark.png" width="700" height="93" alt="Tech Off My Plate"></a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle">
    <div class="nav-links">
      <a href="/#services">How I Can Help</a>
      <a href="/#how">How We Work</a>
      <a href="/#about">About</a>
      <a href="/#faq">FAQ</a>
      <a href="/blog/">Blog</a>
      <a class="btn btn-primary" href="https://calendar.app.google/5X8u7FaaufFGnoS19" target="_blank" rel="noopener">Free Intro Call</a>
    </div>
    <label for="nav-toggle" class="nav-toggle-btn"><span></span><span></span><span></span></label>
  </div>
</nav>

{{ content | safe }}

<p>&copy; 2026 Tech Off My Plate &middot; techoffmyplate.com &middot; <a href="/privacy/">Privacy Notice</a></p>
</div>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", user => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
</body>
</html>
